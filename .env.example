# PostgreSQL connection. Use a pooled URL for serverless deployments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/routara?sslmode=require"
# Direct connection for migrations (may equal DATABASE_URL for local PostgreSQL).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/routara?sslmode=require"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=""
# Public canonical origin, without a trailing slash. Set before production build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional. Only set to a header that YOUR hosting proxy overwrites, never trusts from clients.
# On Vercel, use x-vercel-forwarded-for. Leave empty for per-email limiting only.
TRUSTED_IP_HEADER=""
# Optional official links. These default to ROUTARA's verified community accounts.
NEXT_PUBLIC_X_URL="https://x.com/routarachain"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/routarachain"
# Required for a public launch: a monitored address for privacy/data requests.
NEXT_PUBLIC_PRIVACY_EMAIL=""
